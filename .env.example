# Supabase — enables optional sync + social (Phase 2A).
# Copy to `.env.local` for development, and set the same two vars in the
# Cloudflare Pages project (Settings → Environment variables) for the deploy.
# Leave unset to run the app as a purely local, offline app.
#
# Find these in your Supabase project: Settings → API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
